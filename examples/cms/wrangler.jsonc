{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cms-fixture",
  "main": "worker.ts",
  "compatibility_date": "2026-11-26",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "vars": { "ENVIRONMENT": "development" },
  // The delivery path under tapedb dev: webhooks go to this Worker on the
  // fixture's test port. A deployment generates its own values.
  "define": { "__CMS_PUBLIC_URL__": "\"http://localhost:8793\"", "__CMS_HOOK_SECRET__": "\"local-hook-secret-not-for-deployment\"" },
  "durable_objects": {
    "bindings": [{ "name": "WORKSPACE", "class_name": "WorkspaceRoom" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["WorkspaceRoom"] }],
  "images": { "binding": "IMAGES" },
  "r2_buckets": [
    { "binding": "DATA", "bucket_name": "cms-fixture-data" },
    { "binding": "FILES", "bucket_name": "cms-fixture-files" },
    { "binding": "CONTENT", "bucket_name": "cms-fixture-content" }
  ]
}
