{
  "version": 1,
  "models": {
    "contact": {
      "table": "contact",
      "attributes": {
        "name": {
          "type": "string",
          "optional": false,
          "indexed": false,
          "unique": false
        },
        "email": {
          "type": "string",
          "optional": true,
          "indexed": true,
          "unique": false
        }
      }
    },
    "conversation": {
      "table": "conversation",
      "attributes": {
        "subject": {
          "type": "string",
          "optional": false,
          "indexed": false,
          "unique": false
        },
        "status": {
          "type": "string",
          "optional": false,
          "indexed": true,
          "unique": false,
          "default": "open"
        },
        "assigneeId": {
          "type": "string",
          "optional": true,
          "indexed": true,
          "unique": false
        },
        "lastReadAt": {
          "type": "number",
          "optional": false,
          "indexed": false,
          "unique": false,
          "default": 0
        },
        "contactId": {
          "type": "string",
          "optional": false,
          "indexed": true,
          "unique": false,
          "references": {
            "table": "contact",
            "column": "id",
            "onDelete": "SET NULL"
          }
        }
      }
    },
    "message": {
      "table": "message",
      "attributes": {
        "body": {
          "type": "string",
          "optional": false,
          "indexed": false,
          "unique": false
        },
        "sender": {
          "type": "string",
          "optional": false,
          "indexed": true,
          "unique": false
        },
        "sentAt": {
          "type": "number",
          "optional": false,
          "indexed": true,
          "unique": false
        },
        "conversationId": {
          "type": "string",
          "optional": false,
          "indexed": true,
          "unique": false,
          "references": {
            "table": "conversation",
            "column": "id",
            "onDelete": "CASCADE"
          }
        }
      }
    }
  }
}
