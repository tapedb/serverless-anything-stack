{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project.schema.json",
  "title": "Project",
  "description": "The engineering plan and delivery record for building the serverless application an assessment proposed: requirements by MoSCoW priority, use cases with acceptance criteria tied to tests, diagrams, milestones and environments. Lives next to its assessment.json; its test ids are that assessment's test ids.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "goal", "approval", "actors", "requirements", "useCases", "diagrams", "milestones", "environments"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Same id as the assessment." },
    "goal": { "type": "string", "minLength": 1, "description": "What the owner asked for, in their words, and what done means." },
    "repository": { "type": "string", "pattern": "^https://", "description": "Where the application's code lives." },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "description": "The owner's go-ahead on the assessment and scope before engineering starts.",
      "properties": {
        "status": { "enum": ["pending", "approved", "rejected"] },
        "by": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "notes": { "type": "string" }
      }
    },
    "actors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "description"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "description": { "type": "string", "minLength": 1 }
        }
      }
    },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "priority", "rationale", "capabilities", "useCases"],
        "properties": {
          "id": { "type": "string", "pattern": "^R[0-9]+$" },
          "title": { "type": "string", "minLength": 1 },
          "priority": { "enum": ["must", "should", "could", "wont"], "description": "MoSCoW. wont means not in this release, with the reason in rationale." },
          "rationale": { "type": "string", "minLength": 1 },
          "capabilities": { "type": "array", "items": { "type": "string" }, "description": "Capability ids in the assessment this requirement depends on." },
          "useCases": { "type": "array", "items": { "type": "string" } },
          "nonFunctional": { "type": "boolean", "description": "A quality requirement (latency, availability, cost, security) rather than a feature." }
        }
      }
    },
    "useCases": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "actor", "preconditions", "mainFlow", "acceptance"],
        "properties": {
          "id": { "type": "string", "pattern": "^UC-[0-9]+$" },
          "title": { "type": "string", "minLength": 1 },
          "actor": { "type": "string" },
          "preconditions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "mainFlow": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
          "alternateFlows": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "acceptance": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["criterion", "tests"],
              "properties": {
                "criterion": { "type": "string", "minLength": 1, "description": "Given/when/then, or one observable outcome." },
                "tests": { "type": "array", "items": { "type": "string" }, "description": "Test ids in the assessment." }
              }
            }
          }
        }
      }
    },
    "diagrams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "file"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "kind": { "enum": ["context", "container", "sequence", "data-model", "deployment", "state"] },
          "file": { "type": "string", "minLength": 1, "description": "Path relative to project.json of a Markdown file holding a mermaid block." },
          "covers": { "type": "array", "items": { "type": "string" }, "description": "Use case ids a sequence diagram shows." }
        }
      }
    },
    "milestones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "title", "requirements", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^M[0-9]+$" },
          "title": { "type": "string", "minLength": 1 },
          "requirements": { "type": "array", "items": { "type": "string" } },
          "status": { "enum": ["planned", "in-progress", "done"] },
          "notes": { "type": "string" }
        }
      }
    },
    "environments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": { "enum": ["local", "preview", "staging", "production"] },
          "status": { "enum": ["planned", "deployed", "retired"] },
          "url": { "type": "string", "pattern": "^https?://" },
          "version": { "type": "string", "description": "Commit or Worker version id that is running." },
          "deployedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "approvedBy": { "type": "string", "minLength": 1, "description": "Who gave the go-ahead to deploy here. Required for staging and production." },
          "e2eTests": { "type": "array", "items": { "type": "string" }, "description": "Test ids that ran against this environment." }
        }
      }
    }
  }
}
