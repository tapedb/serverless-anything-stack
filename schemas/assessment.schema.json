{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "assessment.schema.json",
  "title": "Assessment",
  "description": "An evidence-based assessment of moving one self-hosted application onto Cloudflare.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "upstream", "evidence", "features", "dependencies", "workloadAssumptions", "architecture", "capabilities", "risks", "costAssumptions", "decisions", "tests", "approach"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "upstream": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "url", "revision", "license", "inspectedAt"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "type": "string", "pattern": "^https://" },
        "revision": { "type": "string", "minLength": 1, "description": "A commit hash or tag, never a branch name." },
        "license": { "type": "string", "minLength": 1, "description": "SPDX id as found in the repository, or UNKNOWN." },
        "inspectedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "approach": { "enum": ["direct-port", "component-adaptation", "compatible-rewrite", "infeasible", "undecided"] },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "ref", "note"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "kind": { "enum": ["source", "manifest", "documentation", "test", "run", "pricing"] },
          "ref": { "type": "string", "minLength": 1, "description": "A path at the pinned revision, a URL, or a test id." },
          "revision": { "type": "string" },
          "checkedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "features": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "workload", "evidence"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "workload": { "enum": ["transactional", "realtime", "asynchronous", "ingestion", "analytical", "object-storage", "identity-protocol", "compute"] },
          "evidence": { "type": "array", "items": { "type": "string" } },
          "capabilities": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "evidence"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "required": { "type": "boolean" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "workloadAssumptions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "architecture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary", "components"],
      "properties": {
        "summary": { "type": "string", "minLength": 1 },
        "components": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "primitive", "responsibility"],
            "properties": {
              "name": { "type": "string" },
              "primitive": { "type": "string" },
              "responsibility": { "type": "string" }
            }
          }
        }
      }
    },
    "capabilities": { "type": "array", "items": { "$ref": "capability.schema.json" } },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "mitigation"],
        "properties": {
          "id": { "type": "string" },
          "description": { "type": "string", "minLength": 1 },
          "mitigation": { "type": "string", "minLength": 1 }
        }
      }
    },
    "costAssumptions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["driver", "assumption", "source"],
        "properties": {
          "driver": { "type": "string" },
          "assumption": { "type": "string" },
          "source": { "type": "string", "description": "An evidence id of kind pricing, or UNPRICED." }
        }
      }
    },
    "decisions": { "type": "array", "items": { "$ref": "decision.schema.json" } },
    "tests": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description", "runtime", "result"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9.-]*$" },
          "description": { "type": "string", "minLength": 1 },
          "command": { "type": "string" },
          "runtime": { "enum": ["local", "workerd-local", "deployed", "manual"] },
          "result": { "enum": ["pass", "fail", "not-run"] },
          "ranAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
          "evidence": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
