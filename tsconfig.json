{
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": [
      "node"
    ],
    "skipLibCheck": true
  },
  "include": [
    "scripts/*.ts",
    "tests/*.ts",
    "templates/*.ts"
  ]
}
